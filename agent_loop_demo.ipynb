        "def search_sports(query: str) -> list[str]:\n",
        "  \"\"\"Searches the database for sports matching a query string.\n",
        "\n",
        "  Matches against the sport name, description, equipment, or governing body.\n",
        "  Case-insensitive.\n",
        "\n",
        "  Args:\n",
        "      query: Search term (e.g., \"racket\", \"ice\", \"FIFA\", \"outdoors\")\n",
        "\n",
        "  Returns:\n",
        "      A list of matching sport names.\n",
        "  \"\"\"\n",
        "  query_lower = query.lower()\n",
        "  results = []\n",
        "  for name, details in SPORTS.items():\n",
        "    if query_lower in name.lower():\n",
        "      results.append(name)\n",
        "      continue\n",
        "    if query_lower in details[\"description\"].lower():\n",
        "      results.append(name)\n",
        "      continue\n",
        "    if query_lower in details[\"governing_body\"].lower():\n",
        "      results.append(name)\n",
        "      continue\n",
        "    if any(query_lower in eq.lower() for eq in details[\"equipment\"]):\n",
        "      results.append(name)\n",
        "      continue\n",
        "    if query_lower in details[\"environment\"].lower():\n",
        "      results.append(name)\n",
        "      continue\n",
        "\n",
        "  return results\n",
        "\n",
        "\n",
        "def get_sport_details(sport_name: str) -> dict:\n",
        "  \"\"\"Retrieves full details for a specific sport by name.\n",
        "\n",
        "  Args:\n",
        "      sport_name: Exact name of the sport (e.g., \"Basketball\", \"Tennis\")\n",
        "\n",
        "  Returns:\n",
        "      A dictionary of sport details, or an error message if not found.\n",
        "  \"\"\"\n",
        "  if sport_name in SPORTS:\n",
        "    return {\"sport\": sport_name, **SPORTS[sport_name]}\n",
        "\n",
        "  for name, details in SPORTS.items():\n",
        "    if name.lower() == sport_name.lower():\n",
        "      return {\"sport\": name, **details}\n",
        "\n",
        "  return {\"error\": f\"Sport '{sport_name}' not found. Try searching first.\"}"
      ]
    },
