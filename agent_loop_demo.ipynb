        "import inspect\n",
        "import json\n",
        "import os\n",
        "import time\n",
        "from google import genai\n",
        "from google.genai import types\n",
        "\n",
        "# Define our tool registry\n",
        "tools = [search_sports, get_sport_details]\n",
        "# Map tool names to actual functions for quick execution lookup\n",
        "tool_map = {func.__name__: func for func in tools}\n",
        "\n",
        "# Initialize Gemini Client\n",
        "client = genai.Client()\n",
        "# Using gemini-2.5-flash as our standard light model\n",
        "MODEL_ID = 'gemini-2.5-flash'\n",
        "\n",
        "\n",
        "def send_with_retry(\n",
        "    client, model, contents, config=None, retries=5, initial_delay=5\n",
        "):\n",
        "  \"\"\"Sends a request to the Gemini API, retrying with exponential backoff on 503 (Server Overloaded) errors.\n",
        "\n",
        "  Wait times scale: 5s, 10s, 15s, 20s, 25s\n",
        "  \"\"\"\n",
        "  for attempt in range(retries):\n",
        "    try:\n",
        "      return client.models.generate_content(\n",
        "          model=model, contents=contents, config=config\n",
        "      )\n",
        "    except Exception as e:\n",
        "      if \"503\" in str(e) or \"UNAVAILABLE\" in str(e):\n",
        "        if attempt < retries - 1:\n",
        "          delay = initial_delay * (attempt + 1)\n",
        "          print(f\"  Server busy, retrying in {delay}s...\")\n",
        "          time.sleep(delay)\n",
        "        else:\n",
        "          raise e\n",
        "      else:\n",
        "        raise e\n",
        "\n",
        "\n",
        "def run_agent(user_question: str, max_turns: int = 10):\n",
        "  \"\"\"Executes the complete AI Agent Loop.\n",
        "\n",
        "  The model can decide to answer directly OR request a tool call.\n",
        "  When a tool is requested, we run it and feed the output BACK into the model.\n",
        "  This loop continues until the model gives a final text answer.\n",
        "  \"\"\"\n",
        "  print(f'\\n{\"=\"*60}')\n",
        "  print(f'Question: {user_question}')\n",
        "  print(f'{\"=\"*60}')\n",
        "\n",
        "  # 1. Initialize conversation history with System Instruction and User Question\n",
        "  messages = [\n",
        "      types.Content(\n",
        "          role='user',\n",
        "          parts=[\n",
        "              types.Part.from_text(\n",
        "                  text=f\"\"\"You are a sports data assistant. \n",
        "Answer the question using the available tools. \n",
        "Do not guess information \u2014 use search_sports and get_sport_details.\n",
        "\n",
        "Question: {user_question}\"\"\"\n",
        "              )\n",
        "          ],\n",
        "      )\n",
        "  ]\n",
        "\n",
        "  # Config enabling model to call our python functions\n",
        "  config = types.GenerateContentConfig(\n",
        "      tools=tools,\n",
        "      temperature=0.0,  # 0.0 for deterministic tool usage\n",
        "  )\n",
        "\n",
        "  # 2. Start the Agent Loop\n",
        "  for turn in range(1, max_turns + 1):\n",
        "    print(f'\\n--- Turn {turn} ---')\n",
        "\n",
        "    # Send current history to model with retries\n",
        "    response = send_with_retry(\n",
        "        client=client, model=MODEL_ID, contents=messages, config=config\n",
        "    )\n",
        "\n",
        "    # Check if model provided a response candidate\n",
        "    if not response.candidates:\n",
        "      print('No response candidate returned.')\n",
        "      break\n",
        "\n",
        "    # Extract model's response content and add it to message history\n",
        "    model_content = response.candidates[0].content\n",
        "    messages.append(model_content)\n",
        "\n",
        "    # Check if the model called any tools\n",
        "    function_calls = response.function_calls\n",
        "\n",
        "    if function_calls:\n",
        "      # --- PATH A: Model requested tool call(s) ---\n",
        "      for call in function_calls:\n",
        "        func_name = call.name\n",
        "        func_args = dict(call.args)\n",
        "\n",
        "        print(f'Model requested Tool: {func_name}({func_args})')\n",
        "\n",
        "        # Execute local Python function corresponding to requested tool name\n",
        "        if func_name in tool_map:\n",
        "          tool_result = tool_map[func\_name](https://www.google.com/search?q=**func_args)\n",
        "          print(f'Tool Output: {tool_result}')\n",
        "\n",
        "          # TODO 1: Wrap tool output into a FunctionResponse Part.\n",
        "          tool_response_part = types.Part.from_function_response(\n",
        "              name=func_name,\n",
        "              response={'result': tool_result}\n",
        "          )\n",
        "\n",
        "          # TODO 2: Append tool result as a 'user' role content message.\n",
        "          messages.append(\n",
        "              types.Content(\n",
        "                  role='user',\n",
        "                  parts=[tool_response_part]\n",
        "              )\n",
        "          )\n",
        "\n",
        "        else:\n",
